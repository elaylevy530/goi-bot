# TanStack Start frontend — copy to .env and fill values (never commit .env)

# NestJS API base URL. Used by src/lib/api-client.ts and nest-auth.ts
# In local dev, Vite also proxies Nest-owned paths listed in vite.config.ts
VITE_API_URL=http://localhost:3001

# Sibling apps (absolute URLs for redirects + hub links)
# VITE_PARTNERS_URL = movers/couriers marketing + join (courier ops live in this app)
VITE_LANDING_URL=http://localhost:5175
VITE_PARTNERS_URL=http://localhost:5176
VITE_HOVALOT_URL=http://localhost:5174


# Server-side Nest calls from TanStack createServerFn (defaults to VITE_API_URL)
# API_URL=http://localhost:3001

# Required for WhatsApp ensureCustomerAccount / classify-phone from TanStack SSR
# Must match goi-bot-backend CRON_SECRET
# CRON_SECRET=

# Maps / connectors (optional)
# VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
# VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# Product auth and API data access are handled by Nest.
