# NestJS API — copy to .env and fill values (never commit .env)
NODE_ENV=development
PORT=3001

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# PostgreSQL (TypeORM)
# Prefer DATABASE_URL in production (Fly Postgres attach injects this).
# DATABASE_URL=postgres://user:pass@host:5432/dbname
#
# Or discrete vars for local/pgAdmin:
# pgAdmin "Host name/address" → DB_HOST
# pgAdmin "Port" → DB_PORT
# pgAdmin "Username" → DB_USERNAME
# pgAdmin "Password" → DB_PASSWORD
# pgAdmin database name → DB_NAME
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=goi_bot
# Schema is created/updated only via TypeORM synchronize + entities (no migrations)
DB_SYNCHRONIZE=true

# Nest JWT auth (Passport JWT). Use a long random secret in real environments.
JWT_SECRET=
# Optional token lifetime (default 7d)
# JWT_EXPIRES_IN=7d

# Local file storage root (default: ./uploads)
# UPLOAD_DIR=./uploads

# Shared secret for workers + internal provisioning (ensure-customer, classify-phone)
# Authorization: Bearer <CRON_SECRET>  or  X-Cron-Secret: <CRON_SECRET>
# CRON_SECRET=

# WhatsApp / Green API (optional until webhooks/workers send)
# GREEN_API_INSTANCE_ID=
# GREEN_API_TOKEN=
# WHATSAPP_CLOUD_VERIFY_TOKEN=
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_APP_SECRET=
# WHATSAPP_CLOUD_API_VERSION=v21.0

# PayPal (optional)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
# PAYPAL_WEBHOOK_ID=

# Chat push webhook (DB trigger -> Nest `/api/public/hooks/chat-push`)
# CHAT_PUSH_TOKEN=

# OPENAI_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@goi-bot.lovable.app

# Admin assistant (Lovable AI Gateway) — /api/admin-chat
# LOVABLE_API_KEY=

